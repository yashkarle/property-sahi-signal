# Database
DATABASE_URL=postgresql+asyncpg://property_user:property_pass@localhost:5432/property_sahi

# Redis
REDIS_URL=redis://localhost:6379/0

# AWS (use real values for prod; LocalStack uses test/test)
AWS_DEFAULT_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# OpenSearch
OPENSEARCH_ENDPOINT=http://localhost:4566
OPENSEARCH_INDEX=properties-v1
USE_LOCALSTACK=true

# Bedrock model IDs
BEDROCK_LLM_MODEL_ID=anthropic.claude-sonnet-4-5
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Decision Hub (dhub) - PyMC skill
DHUB_BASE_URL=https://hub.decision.ai
DHUB_PYMC_SKILL_PATH=/skills/pymc-labs/pymc-modeling
DHUB_API_KEY=your-dhub-api-key

# Google Maps (geocoding)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Security
API_KEY=change-me-in-production

# S3 (model cache)
MODEL_CACHE_BUCKET=property-sahi-model-cache

# Substack
SUBSTACK_PUBLICATION_URL=https://your-publication.substack.com
SUBSTACK_API_KEY=your-substack-session-token

# App
APP_ENV=development
LOG_LEVEL=INFO
